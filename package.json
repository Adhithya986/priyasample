{
  "name": "local-pickup",
  "version": "1.0.0",
  "private": true,
  "description": "Local Pickup - Book before you go. Pick up when you arrive.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx backend/src/seed.ts",
    "test": "npm run test --workspace=backend"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "prisma": "^5.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  }
}
