# Local Pickup Platform Environment Configuration

# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# For local Windows dev cluster initialized on port 5433:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/localpickup?schema=public"
# For Docker or standard PostgreSQL on port 5432:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localpickup?schema=public"

# Authentication
JWT_SECRET=super-secret-jwt-key-for-local-pickup-2026-min32chars
JWT_EXPIRES_IN=7d

# Document Storage & Retention
# Filesystem path for private document storage (outside public web root)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
# Document retention period in hours after pickup before automated deletion
DOCUMENT_RETENTION_HOURS=24
